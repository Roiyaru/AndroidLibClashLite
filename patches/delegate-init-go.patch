+// resolvePackageName maps a connection back to the app that owns the socket.
+//
+// Native TUN inbounds hand over the real socket addresses (RawSrcAddr /
+// RawDstAddr). SOCKS inbounds - the path used by Hev TUN - do not: the tunnel
+// terminates the app flow and dials the core again from loopback, so only the
+// original source port survives (kept by the patched hev-socks5-tunnel) and the
+// destination has to be rebuilt from metadata.
+func resolvePackageName(metadata *constant.Metadata) (string, error) {
+	if metadata.RawSrcAddr != nil && metadata.RawDstAddr != nil {
 		uid := app.QuerySocketUid(metadata.RawSrcAddr, metadata.RawDstAddr)
 		pkg := app.QueryAppByUid(uid)
-
 		log.Debugln("[PKG] %s --> %s by %d[%s]", metadata.SourceAddress(), metadata.RemoteAddress(), uid, pkg)
-
 		return pkg, nil
 	}
 
-	dialer.DefaultSocketHook = func(network, address string, conn syscall.RawConn) error {
-		if platform.ShouldBlockConnection() {
-			return errBlocked
+	srcAddrPort := metadata.SourceAddrPort()
+	if !metadata.SourceValid() || !srcAddrPort.IsValid() || srcAddrPort.Port() == 0 {
+		return "", process.ErrInvalidNetwork
+	}
+
+	candidates := destinationCandidates(metadata)
+	if len(candidates) == 0 {
+		return "", process.ErrInvalidNetwork
+	}
+
+	for _, dstAddrPort := range candidates {
+		uid := app.QuerySocketUid(
+			metadataAddr(metadata.NetWork, srcAddrPort),
+			metadataAddr(metadata.NetWork, dstAddrPort),
+		)
+		if pkg := app.QueryAppByUid(uid); pkg != "" {
+			log.Debugln("[PKG] %s --> %s by %d[%s]", metadata.SourceAddress(), dstAddrPort.String(), uid, pkg)
+			return pkg, nil
 		}
+	}
 
-		return conn.Control(func(fd uintptr) {
-			app.MarkSocket(int(fd))
-		})
+	log.Debugln("[PKG] %s --> %s: no owner (host %q, dstIP %v, dstPort %d)",
+		metadata.SourceAddress(), metadata.RemoteAddress(), metadata.Host, metadata.DstIP, metadata.DstPort)
+	return "", nil
+}
+
+// destinationCandidates returns every destination tuple the app socket may
+// hold. With sniffer override-destination the core clears DstIP and keeps only
+// the domain, so the name is resolved back to the addresses the app dialed.
+func destinationCandidates(metadata *constant.Metadata) []netip.AddrPort {
+	candidates := make([]netip.AddrPort, 0, 8)
+	if metadata.DstIP.IsValid() {
+		candidates = append(candidates, netip.AddrPortFrom(metadata.DstIP.Unmap(), metadata.DstPort))
+	}
+
+	if metadata.Host == "" || metadata.DstPort == 0 {
+		return candidates
+	}
+	if resolver.DefaultResolver == nil && resolver.SystemResolver == nil {
+		return candidates
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), ownerLookupTimeout)
+	defer cancel()
+	ips, err := resolver.LookupIP(ctx, metadata.Host)
+	if err != nil {
+		log.Debugln("[PKG] resolve %s for owner lookup failed: %s", metadata.Host, err.Error())
+		return candidates
+	}
+	for _, ip := range ips {
+		addrPort := netip.AddrPortFrom(ip.Unmap(), metadata.DstPort)
+		if len(candidates) > 0 && candidates[0] == addrPort {
+			continue
+		}
+		candidates = append(candidates, addrPort)
+	}
+	return candidates
+}
+
+func metadataAddr(netWork constant.NetWork, addrPort netip.AddrPort) net.Addr {
+	if netWork == constant.UDP {
+		return net.UDPAddrFromAddrPort(addrPort)
 	}
+	return net.TCPAddrFromAddrPort(addrPort)
 }
